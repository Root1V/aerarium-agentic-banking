{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT t.idempotency_key, e.amount_micros, e.currency\n            FROM ledger_entries e\n            JOIN ledger_transactions t ON t.id = e.transaction_id\n            WHERE e.account_id = $1\n              AND t.posted_at >= $2\n              AND t.idempotency_key LIKE $3\n            ",
