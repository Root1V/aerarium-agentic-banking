  "db_name": "PostgreSQL",
  "query": "\n            SELECT t.idempotency_key, e.amount_micros, e.currency, t.posted_at\n            FROM ledger_entries e\n            JOIN ledger_transactions t ON t.id = e.transaction_id\n            WHERE e.account_id = $1 AND t.posted_at < $2\n            ORDER BY t.posted_at\n            ",
